name = "mwqcodex/moonwind"

version = "0.2.0"

readme = "README.mbt.md"

repository = "https://github.com/mwqcodex/moonwind"

license = "Apache-2.0"

keywords = [
  "flight-planning",
  "winds-aloft",
  "aviation",
  "wind-triangle",
  "wintem",
  "fd",
]

preferred_target = "wasm"

description = "Flight planning from winds-aloft forecasts in pure MoonBit: read the WMO WINTEM / US FD bulletins, interpolate the wind between forecast levels, and turn them into headings, ground speeds, times, fuel and the best level to fly."
