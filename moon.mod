name = "MWQCODEX/moonwind"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/MWQCODEX/moonwind"

license = "Apache-2.0"

keywords = [
  "weather",
  "meteorology",
  "humidity",
  "apparent-temperature",
  "pressure-altitude",
  "beaufort",
  "wind-barb",
  "aviation",
  "winds-aloft",
  "wind-triangle",
  "flight-planning",
]

preferred_target = "wasm"

description = "Weather computation in pure MoonBit: humidity, apparent temperature, pressure and altitude, the Beaufort scale, wind barbs, and winds-aloft (FD) flight calculations"
